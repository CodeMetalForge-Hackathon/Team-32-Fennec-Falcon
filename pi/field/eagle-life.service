[Unit]
StartLimitIntervalSec=0
Description=Eagle field: life_node (thermal + audio + vision -> life list -> Nest, recorded to ~/field_logs)
After=eagle-nest.service sound.target
Wants=eagle-nest.service
# These open the same thermal camera / microphone.
Conflicts=thermal.service fusion.service

[Service]
User=@USER@
WorkingDirectory=@REPO@/eagle-kit
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/mkdir -p @HOME@/field_logs @HOME@/eagle
# Exit 3 if the thermal camera or the mic array is missing (USB still enumerating at boot): systemd retries.
# run_life.sh adds --record @HOME@/field_logs unless ~/eagle/norecord exists (field page Start/Stop recording).
ExecStart=@REPO@/pi/field/run_life.sh
StandardOutput=append:@HOME@/field_logs/life.log
StandardError=append:@HOME@/field_logs/life.log
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
