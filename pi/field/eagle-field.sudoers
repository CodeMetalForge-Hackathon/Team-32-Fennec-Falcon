# Installed by pi/field/install.sh as /etc/sudoers.d/eagle-field. Lets the field page (running as @USER@)
# start, stop and restart the eagle services and reboot or power off, with no password. Nothing else.
@USER@ ALL=(root) NOPASSWD: /usr/bin/systemctl start eagle-*, /usr/bin/systemctl stop eagle-*, /usr/bin/systemctl restart eagle-*, /usr/bin/systemctl reboot, /usr/bin/systemctl poweroff
