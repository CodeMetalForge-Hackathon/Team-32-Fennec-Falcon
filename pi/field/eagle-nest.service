[Unit]
Description=Eagle field: Nest station (decrypts LIFE/FIX frames from life_node, CoT out)
After=local-fs.target

[Service]
User=@USER@
WorkingDirectory=@REPO@/eagle-kit
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/mkdir -p @HOME@/field_logs
ExecStart=@HOME@/hailo-apps/venv_hailo_apps/bin/python apps/nest_station.py --config @REPO@/pi/field/field.yaml --transport udp --print-cot
StandardOutput=append:@HOME@/field_logs/nest.log
StandardError=append:@HOME@/field_logs/nest.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
